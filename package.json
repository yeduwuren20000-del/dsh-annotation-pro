{
  "name": "dsh-annotation-pro",
  "displayName": "DSH Annotation Pro",
  "description": "选中任意消息（AI 回复或自己的话）写批注，以「注释 N」编号插入输入框并随消息发送；编号稳定不重排，带二次元看板娘。",
  "version": "0.5.0",
  "license": "MIT",
  "author": "yeduwuren",
  "homepage": "https://github.com/yeduwuren20000-del/dsh-annotation-pro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeduwuren20000-del/dsh-annotation-pro.git"
  },
  "bugs": {
    "url": "https://github.com/yeduwuren20000-del/dsh-annotation-pro/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "bundle",
    "annotation",
    "notes"
  ],
  "type": "module",
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-input-trigger": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-commands": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-store": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4.0.0",
    "react": "^18.2.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "package.json"
  ]
}
